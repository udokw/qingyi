<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingTop="14dp"
    android:paddingBottom="14dp">

    <!-- 墨白: 眉题行(对局 · 第 X 手, 右上小印章) -->
    <LinearLayout
        android:id="@+id/rowEyebrow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvEyebrow"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:letterSpacing="0.3"
            android:paddingStart="20dp"
            android:text="象棋 · 第 一 着"
            android:textColor="#6B665C"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvSealMini"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingLeft="5dp"
            android:paddingRight="5dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:text="清"
            android:textColor="#FFFFFF"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- 状态行 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvStatusL"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="我执红"
            android:textColor="#1A1A1A"
            android:textSize="18sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:padding="6dp"
            android:text="加载中…"
            android:textColor="#1A1A1A"
            android:textSize="17sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:id="@+id/divTop"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="10dp"
        android:background="#DDD6C4"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvSubStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:letterSpacing="0.1"
        android:text="9 × 10 · 中国象棋"
        android:textColor="#9A9384"
        android:textSize="14sp" />

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <com.sijia.go.XiangqiBoardView
        android:id="@+id/boardView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp" />

    <!-- 最近着法(中文记谱) -->
    <TextView
        android:id="@+id/tvMoveLine"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:ellipsize="start"
        android:gravity="center"
        android:maxLines="1"
        android:singleLine="true"
        android:textColor="#9A9384"
        android:textSize="13sp" />

    <!-- 粉彩: 棋盘底座小字 -->
    <TextView
        android:id="@+id/tvMotto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:letterSpacing="0.3"
        android:text="楚 河 汉 界 · 一 局 清 弈"
        android:textColor="#B0A79B"
        android:textSize="11sp"
        android:visibility="gone" />

    <!-- 墨白: 按钮网格上横线 -->
    <View
        android:id="@+id/gridTop"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="22dp"
        android:background="#DDD6C4"
        android:visibility="gone" />

    <!-- 操作行: 悔棋 认输 求和 -->
    <LinearLayout
        android:id="@+id/row1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnUndo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="悔棋" />

        <View
            android:id="@+id/vG1"
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="#DDD6C4"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnResign"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="认输" />

        <View
            android:id="@+id/vG2"
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="#DDD6C4"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnDraw"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="求和" />
    </LinearLayout>

    <!-- 墨白: 网格下横线 -->
    <View
        android:id="@+id/gridBottom"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#DDD6C4"
        android:visibility="gone" />

    <!-- 复盘导航行 -->
    <LinearLayout
        android:id="@+id/rowNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:visibility="gone">

        <Button
            android:id="@+id/btnPrev"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="◀ 上一步" />

        <View
            android:id="@+id/vG3"
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="#DDD6C4"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnNext"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="下一步 ▶" />
    </LinearLayout>

    <!-- 墨白: 底部签字 -->
    <TextView
        android:id="@+id/tvSign"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="center"
        android:letterSpacing="0.25"
        android:text="PIKAFISH · 清 弈"
        android:textColor="#9A9384"
        android:textSize="11sp"
        android:visibility="gone" />

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>
