<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingLeft="24dp"
    android:paddingRight="24dp"
    android:paddingTop="20dp"
    android:paddingBottom="24dp">

    <!-- 标题: 左侧主题印记 + serif 标题 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <View
            android:id="@+id/tvDlgMark"
            android:layout_width="9dp"
            android:layout_height="9dp"
            android:layout_marginEnd="10dp" />

        <TextView
            android:id="@+id/tvDlgTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="人机对弈设置"
            android:textColor="#1A1A1A"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:id="@+id/divDlg"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="16dp"
        android:background="#DDD6C4" />

    <TextView
        android:id="@+id/tvLbEngine"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:text="引擎"
        android:textColor="#6B665C"
        android:textSize="13sp" />

    <RadioGroup
        android:id="@+id/rgEngine"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="14dp"
        android:orientation="vertical">

        <RadioButton
            android:id="@+id/rbGnu"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:paddingStart="8dp"
            android:text="经典 GNU Go · 传统算法, 最快最弱"
            android:textSize="15sp" />

        <RadioButton
            android:id="@+id/rbPachi"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="8dp"
            android:text="快棋 Pachi · 蒙特卡洛, 应手飞快"
            android:textSize="15sp" />

        <RadioButton
            android:id="@+id/rbKatago"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="8dp"
            android:text="高手 KataGo · 神经网络, 棋力最强"
            android:textSize="15sp" />
    </RadioGroup>

    <TextView
        android:id="@+id/tvLbColor"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:text="执子"
        android:textColor="#6B665C"
        android:textSize="13sp" />

    <RadioGroup
        android:id="@+id/rgColor"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="14dp"
        android:orientation="horizontal">

        <RadioButton
            android:id="@+id/rbBlack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:layout_marginEnd="28dp"
            android:paddingStart="8dp"
            android:text="执黑"
            android:textSize="15sp" />

        <RadioButton
            android:id="@+id/rbWhite"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="8dp"
            android:text="执白"
            android:textSize="15sp" />
    </RadioGroup>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvLbLevel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="引擎等级 (1-10)"
            android:textColor="#6B665C"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvLevel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="10 级"
            android:textColor="#1A1A1A"
            android:textSize="13sp" />
    </LinearLayout>

    <SeekBar
        android:id="@+id/sbLevel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:max="9"
        android:progress="9" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvLbHandi"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="让子 (0-9)"
            android:textColor="#6B665C"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvHandicap"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="不让子"
            android:textColor="#1A1A1A"
            android:textSize="13sp" />
    </LinearLayout>

    <SeekBar
        android:id="@+id/sbHandicap"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:max="9"
        android:progress="0" />

    <LinearLayout
        android:id="@+id/rowSound"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvLbSound"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="落子音效"
            android:textColor="#6B665C"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvSound"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingLeft="16dp"
            android:paddingRight="4dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:text="开"
            android:textColor="#C73E2B"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

    <Button
        android:id="@+id/btnStart"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="12dp"
        android:text="开始对弈"
        android:textSize="16sp" />
</LinearLayout>
