<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingTop="14dp"
    android:paddingBottom="14dp">

    <!-- 墨白: 眉题行(对局 · 第 X 手, 右上小印章) -->
    <LinearLayout
        android:id="@+id/rowEyebrow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvEyebrow"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:letterSpacing="0.3"
            android:paddingStart="20dp"
            android:text="对局 · 第 一 手"
            android:textColor="#6B665C"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvSealMini"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingLeft="5dp"
            android:paddingRight="5dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:text="清"
            android:textColor="#FFFFFF"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- 状态行: 墨白=左「我执黑」+右「轮到 黑方行棋」; 粉彩=居中整行 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvStatusL"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="我执黑"
            android:textColor="#1A1A1A"
            android:textSize="18sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:padding="6dp"
            android:text="加载中…"
            android:textColor="#1A1A1A"
            android:textSize="17sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 墨白: 状态行下发丝线 -->
    <View
        android:id="@+id/divTop"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="10dp"
        android:background="#DDD6C4"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvSubStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:letterSpacing="0.1"
        android:text="19 路"
        android:textColor="#9A9384"
        android:textSize="14sp" />

    <!-- 弹性留白: 信息区与棋盘之间(与底部对称) -->
    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <com.sijia.go.GoBoardView
        android:id="@+id/boardView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp" />

    <!-- 粉彩: 棋盘底座 -->
    <View
        android:id="@+id/pedestal"
        android:layout_width="140dp"
        android:layout_height="10dp"
        android:layout_gravity="center_horizontal"
        android:visibility="gone" />

    <!-- 粉彩: 底座下小字 -->
    <TextView
        android:id="@+id/tvMotto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:letterSpacing="0.3"
        android:text="安 静 的 一 手"
        android:textColor="#B0A79B"
        android:textSize="11sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvComment"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textColor="#6B665C"
        android:textSize="12sp"
        android:visibility="gone" />

    <!-- 墨白: 按钮网格上横线 -->
    <View
        android:id="@+id/gridTop"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="40dp"
        android:background="#DDD6C4"
        android:visibility="gone" />

    <!-- 第一行: 悔棋 停一手 形势 -->
    <LinearLayout
        android:id="@+id/row1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnUndo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="悔棋" />

        <View
            android:id="@+id/vG1"
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="#DDD6C4"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnPass"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="停一手" />

        <View
            android:id="@+id/vG2"
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="#DDD6C4"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnEstimate"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="形势" />
    </LinearLayout>

    <!-- 墨白: 网格中横线 -->
    <View
        android:id="@+id/gridMid"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#DDD6C4"
        android:visibility="gone" />

    <!-- 第二行: 数子 认输 存谱 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnScore"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="数子" />

        <View
            android:id="@+id/vG3"
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="#DDD6C4"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnResign"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="认输" />

        <View
            android:id="@+id/vG4"
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="#DDD6C4"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnSave"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="存谱" />
    </LinearLayout>

    <!-- 墨白: 网格下横线 -->
    <View
        android:id="@+id/gridBottom"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#DDD6C4"
        android:visibility="gone" />

    <!-- 墨白(打谱): 导航行上横线 -->
    <View
        android:id="@+id/grid3Top"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:background="#DDD6C4"
        android:visibility="gone" />

    <!-- 打谱导航行 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnPrev"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="◀ 上一手"
            android:visibility="gone" />

        <View
            android:id="@+id/vG5"
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="#DDD6C4"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnNext"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="下一手 ▶"
            android:visibility="gone" />
    </LinearLayout>

    <!-- 墨白(打谱): 导航行下横线 -->
    <View
        android:id="@+id/grid3Bottom"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#DDD6C4"
        android:visibility="gone" />

    <!-- 墨白: 底部签字 -->
    <TextView
        android:id="@+id/tvSign"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="center"
        android:letterSpacing="0.25"
        android:text="GNU GO · 清 弈"
        android:textColor="#9A9384"
        android:textSize="11sp"
        android:visibility="gone" />

    <!-- 弹性留白: 签字之下(与棋盘上方对称) -->
    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>
